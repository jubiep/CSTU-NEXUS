# CSTU NEXUS - Environment Configuration
# Copy this file to .env and fill in your actual values:
# cp .env.example .env

# TU Authentication API Application Key (Get from TU API Admin)
TU_API_APPLICATION_KEY=your_tu_api_application_key_here

# Frontend CORS Allowed Origins (comma-separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501

# Frontend container settings
FRONTEND_PORT=3000
FRONTEND_TARGET=production
DB_PORT=5432
BACKEND_PORT=8080
